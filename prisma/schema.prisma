// Prisma schema for Movie Memory.
// User/Account/Session/VerificationToken follow the shape Auth.js (NextAuth)
// expects from its Prisma adapter. We only ADD fields to User; we don't
// invent a parallel users table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String? // Google may not send a name -> optional
  email         String?   @unique
  emailVerified DateTime?
  image         String? // Google photo URL; may be missing -> optional

  // null = onboarding not finished. This (not "is this a new account?")
  // decides whether we route to /onboarding or /dashboard.
  favoriteMovie String?

  accounts Account[]
  sessions Session[]
  facts    Fact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One generated fun fact. We store `movie` on each fact so that:
//  - old facts stay correctly labeled if the user changes their movie
//  - the cache lookup "latest fact for THIS user + THIS movie" is one query
model Fact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     String
  content   String
  createdAt DateTime @default(now())

  // Makes the cache lookup (where userId+movie, order by createdAt desc) fast.
  @@index([userId, movie, createdAt(sort: Desc)])
}

// ---- Auth.js adapter tables (standard shape, don't rename) ----

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
